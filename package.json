  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "js-yaml": "^5.2.2"
  }
}
