{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:fast": "npx playwright test --grep-invert \"@Change-Password|@manual-Captcha\" --workers=4 --reporter=blob",
    "test:slow": "npx playwright test --grep \"@Change-Password\" --workers=1 --reporter=blob",
    "test:merge": "npx playwright merge-reports --reporter=html ./all-blob-reports",
    "test:ci": "rm -rf all-blob-reports && mkdir -p all-blob-reports && (npm run test:fast || true) && cp -r blob-report/* all-blob-reports/ 2>/dev/null || true && (npm run test:slow || true) && cp -r blob-report/* all-blob-reports/ 2>/dev/null || true && npm run test:merge"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "js-yaml": "^5.2.2"
  }
}
