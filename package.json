{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:fast": "npx playwright test --grep-invert \"@Change-Password|@manual-Captcha\" --workers=4 --reporter=blob",
    "test:slow": "npx playwright test --grep \"@Change-Password\" --workers=1 --reporter=blob",
    "test:merge": "npx playwright merge-reports --reporter=html ./blob-report",
    "test:ci": "npm run test:fast || true && npm run test:slow || true && npm run test:merge"
  },
  "keywords": [],
